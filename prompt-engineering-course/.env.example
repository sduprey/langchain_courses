# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).

# Backend: "ollama" (local, free, offline) or "openai" (hosted).
# Track A (S1-S5) uses ollama. Track B (tools, safety) uses openai.
MODEL_BACKEND=ollama

# Local model (Ollama). Pull it first:  ollama pull llama3
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Hosted model (only needed for Track B labs)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-replace-me
